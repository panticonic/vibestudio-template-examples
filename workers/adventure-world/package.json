{
  "name": "@workspace-workers/adventure-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent composable adventure worlds and executable causal behaviors.",
  "dependencies": {
    "@workspace/runtime": "workspace:*",
    "@vibestudio/service-schemas": "workspace:*",
    "acorn": "^8.18.0",
    "@workspace/adventure-engine": "workspace:*",
    "@vibestudio/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "@workspace/adventure-campaigns": "workspace:*"
  },
  "vibestudio": {
    "title": "Adventure World",
    "kind": "worker",
    "entry": "index.ts",
    "tests": [
      {
        "name": "native",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "durable": {
      "classes": [
        {
          "className": "AdventureWorldDO"
        }
      ]
    },
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "critical",
          "evidence": "intentional-broad"
        }
      ]
    },
    "icon": "./assets/icon.svg",
    "services": [
      {
        "action": "play and maintain illustrated adventure worlds",
        "authority": {
          "binding": {
            "declaredFor": [
              "panels/dead-letter-office",
              "panels/missing-country",
              "panels/wandering-house",
              "workers/adventure-agents"
            ]
          },
          "principals": [
            "host",
            "user",
            "code"
          ]
        },
        "description": "Persistent places, characters, story mechanisms and illustrated player journeys.",
        "durableObject": {
          "className": "AdventureWorldDO"
        },
        "name": "adventure",
        "notability": "everyday",
        "presentation": {
          "domain": "automation",
          "verb": "manage"
        },
        "protocols": [
          "examples.adventure.v1"
        ],
        "title": "Adventure worlds"
      }
    ]
  }
}

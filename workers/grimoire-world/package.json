{
  "name": "@workspace-workers/grimoire-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A persistent enchanted garden, interpreted by Moth the familiar.",
  "dependencies": {
    "@workspace/runtime": "workspace:*",
    "@workspace/grimoire-engine": "workspace:*",
    "acorn": "^8.14.0",
    "@workspace/living-canvas": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  },
  "vibestudio": {
    "title": "Grimoire World",
    "icon": "./assets/icon.svg",
    "kind": "worker",
    "entry": "index.ts",
    "tests": [
      {
        "name": "native",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "durable": {
      "classes": [
        {
          "className": "GrimoireWorldDO"
        }
      ]
    },
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "critical",
          "evidence": "intentional-broad"
        }
      ]
    },
    "services": [
      {
        "action": "read and change the state of a Grimoire estate",
        "authority": {
          "binding": {
            "declaredFor": [
              "panels/grimoire",
              "workers/grimoire-agents"
            ]
          },
          "principals": [
            "host",
            "user",
            "code"
          ]
        },
        "description": "Holds the enchanted garden, wishes and their visible consequences so Moth and the player share one truth.",
        "durableObject": {
          "className": "GrimoireWorldDO"
        },
        "name": "grimoire",
        "notability": "everyday",
        "presentation": {
          "domain": "automation",
          "verb": "manage"
        },
        "protocols": [
          "examples.grimoire.v1"
        ],
        "title": "Grimoire estate"
      }
    ]
  }
}

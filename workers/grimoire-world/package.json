{
  "name": "@workspace-workers/grimoire-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The valley of Grimoire: one Durable Object per estate holding the regions, the sky, every spell record and its writing, the persistent wards and bindings, the spirits' wants, the council, the undone list and the news.",
  "dependencies": {
    "@vibestudio/service-schemas": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "@workspace/grimoire-engine": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  },
  "vibestudio": {
    "title": "Grimoire World",
    "icon": "./assets/icon.svg",
    "kind": "worker",
    "entry": "index.ts",
    "tests": [
      {
        "name": "native",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "durable": {
      "classes": [
        {
          "className": "GrimoireWorldDO"
        }
      ]
    },
    "authority": {
      "provides": [],
      "requests": [],
      "serviceRequests": []
    }
  }
}

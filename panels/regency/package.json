{
  "name": "@workspace-panels/regency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Regency: rule a realm through a council of agents, treat with rival sovereigns and their ambassadors, and watch the map change season by season.",
  "vibestudio": {
    "title": "Regency",
    "icon": "./assets/icon.svg",
    "entry": "index.ts",
    "template": "svelte",
    "tests": [
      {
        "name": "native",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "stateArgs": {
      "type": "object",
      "properties": {
        "gameKey": {
          "type": "string"
        },
        "sound": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "provides": [],
      "serviceRequests": [
        {
          "protocol": "examples.regency.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.channel.v1",
          "availability": "required"
        }
      ],
      "requests": [
        {
          "capability": "workspace-service:regency",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "critical",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:channel",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace.runtime-state.manage",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace.runtime-state.inspect",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@workspace/runtime": "workspace:*",
    "@workspace/svelte": "workspace:*",
    "@workspace/regency-engine": "workspace:*",
    "@workspace-skills/agents": "workspace:*",
    "react": "^19.0.0",
    "svelte": "^5.56.9",
    "@workspace/pubsub": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}

{
  "name": "@workspace-panels/grimoire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grimoire: inherit a dead sorcerer's estate, speak verse in the circle, and watch your familiar turn it into the writing under the words. The valley, the study, the spellbook, the scrying page, the spirits and the estate's news.",
  "vibestudio": {
    "title": "Grimoire",
    "icon": "./assets/icon.svg",
    "entry": "index.ts",
    "template": "svelte",
    "tests": [
      {
        "name": "native",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "stateArgs": {
      "type": "object",
      "properties": {
        "estateKey": {
          "type": "string"
        },
        "apprentice": {
          "type": "string"
        },
        "sound": {
          "type": "boolean"
        },
        "view": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "provides": [],
      "serviceRequests": [
        {
          "protocol": "examples.grimoire.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.channel.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.models.v1",
          "availability": "required"
        }
      ],
      "requests": [
        {
          "capability": "workspace-service:grimoire",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "critical",
          "evidence": "intentional-broad"
        },
        {
          "capability": "context.materialize",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "subagents.create",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:channel",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:models",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:gad.workspace",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:workspace.state",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace.runtime-state.manage",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace.runtime-state.inspect",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@workspace/runtime": "workspace:*",
    "@workspace/svelte": "workspace:*",
    "@workspace/grimoire-engine": "workspace:*",
    "@workspace-skills/agents": "workspace:*",
    "@workspace/pubsub": "workspace:*",
    "svelte": "^5.56.9"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}

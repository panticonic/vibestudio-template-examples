{
  "name": "@workspace-panels/grimoire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An enchanted garden that answers ordinary wishes through a familiar agent.",
  "vibestudio": {
    "title": "Grimoire",
    "icon": "./assets/icon.svg",
    "entry": "index.tsx",
    "tests": [
      {
        "name": "native",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "stateArgs": {
      "type": "object",
      "properties": {
        "estateKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "provides": [],
      "serviceRequests": [
        {
          "protocol": "examples.grimoire.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.channel.v1",
          "availability": "required"
        }
      ],
      "requests": [
        {
          "capability": "workspace-service:grimoire",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "critical",
          "evidence": "intentional-broad"
        },
        {
          "capability": "subagents.create",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:channel",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace.runtime-state.manage",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace.runtime-state.inspect",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@workspace/runtime": "workspace:*",
    "@workspace/react": "workspace:*",
    "@workspace/grimoire-engine": "workspace:*",
    "@workspace-skills/agents": "workspace:*",
    "@workspace/pubsub": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@workspace/living-canvas": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
